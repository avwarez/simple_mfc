// test_dialog.rc — a synthetic DIALOGEX exercising the common control set
// (text/no-text controls, generic CONTROL with a window class, unresolved
// app style, id expressions). Not tied to eMule; it isolates the parser.
#include "test_resource.h"

IDD_SAMPLE DIALOGEX 0, 0, 220, 160
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sample ""Quoted"" Dialog"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Name:",IDC_STATIC,7,9,40,8
    EDITTEXT        IDC_NAME_EDIT,50,7,163,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Go",IDC_GO_BUTTON,163,139,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,107,139,50,14
    CONTROL         "Enable feature",IDC_ENABLE_CHECK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,28,120,10
    GROUPBOX        "Options",IDC_GROUP,7,44,206,44
    CONTROL         "Option A",IDC_OPTION_A,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,14,56,90,10
    CONTROL         "Option B",IDC_OPTION_B,"Button",
                    BS_AUTORADIOBUTTON,14,70,90,10
    CONTROL         "",IDC_FILE_LIST,"SysListView32",
                    LVS_REPORT | WS_BORDER | WS_TABSTOP,7,92,206,20
    COMBOBOX        IDC_MODE_COMBO,110,92,103,60,
                    CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "",IDC_PROGRESS_BAR,"msctls_progress32",
                    PBS_SMOOTH | APP_CUSTOM_STYLE,7,116,206,10
END

// Exercises the RC `NOT STYLE` form (as real emule.rc does heavily). If the
// style parser mishandles NOT it desyncs and eats IDD_AFTER below.
IDD_NOTTEST DIALOGEX 0, 0, 100, 60
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION
CAPTION "Not Test"
FONT 8, "MS Shell Dlg"
BEGIN
    PUSHBUTTON      "Hidden",IDC_HIDDEN_BTN,10,10,50,14,NOT WS_VISIBLE | WS_TABSTOP
    EDITTEXT        IDC_NAME_EDIT,10,30,80,12,ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
END

IDD_AFTER DIALOGEX 0, 0, 80, 40
STYLE DS_SETFONT | WS_CHILD
CAPTION "After"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "still here",IDC_AFTER_LABEL,7,7,66,8
END

// Exercises the GDI-independent common controls the Qt driver maps to native
// Qt widgets (slider/progress/spin) plus a radio group for DDX_Radio.
IDD_CONTROLS DIALOGEX 0, 0, 200, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Controls"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "",IDC_SLIDER,"msctls_trackbar32",TBS_HORZ | WS_TABSTOP,7,7,186,15
    CONTROL         "",IDC_PROGRESS2,"msctls_progress32",PBS_SMOOTH,7,26,186,10
    CONTROL         "",IDC_SPIN,"msctls_updown32",UDS_ARROWKEYS | WS_TABSTOP,7,42,20,14
    CONTROL         "First",IDC_RADIO1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,7,60,90,10
    CONTROL         "Second",IDC_RADIO2,"Button",
                    BS_AUTORADIOBUTTON,7,74,90,10
END
